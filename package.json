{
  "name": "@whynotsnow/scroll-head",
  "version": "0.1.0",
  "description": "Headless scroll-aware header controller for content sites.",
  "type": "module",
  "license": "MIT",
  "author": "whynotsnow",
  "repository": {
    "type": "git",
    "url": "git@github.com:whynotsnow/scroll-head.git"
  },
  "bugs": {
    "url": "https://github.com/whynotsnow/scroll-head/issues"
  },
  "homepage": "https://github.com/whynotsnow/scroll-head#readme",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "sticky",
    "header",
    "headless",
    "scroll",
    "blog",
    "vanilla"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "src",
    "styles",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles/base.css": {
      "default": "./styles/base.css"
    },
    "./styles/presets/blog.css": {
      "default": "./styles/presets/blog.css"
    }
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "vite examples/vanilla",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "vite": "^6.0.0"
  }
}
